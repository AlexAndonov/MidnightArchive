@using MidnightArchive.Core.DTOs.ReportDTOs
@model IEnumerable<ReportedStoryAdminDto>

@{
    ViewData["Title"] = "Reported Stories";
}

<section class="reports-page">
    <div class="container reports-page-shell">
        <div class="reports-page-header">
            <h1>Reported Stories</h1>
            <p>Review reported stories and resolve moderation cases.</p>
        </div>

        @if (!Model.Any())
        {
            <div class="reports-empty-state">
                <h3>No reported stories</h3>
                <p>There are no reported stories at the moment.</p>
            </div>
        }
        else
        {
            <div class="reports-table-wrapper">
                <table class="reports-table">
                    <thead>
                        <tr>
                            <th>Story</th>
                            <th>Author</th>
                            <th>Reports</th>
                            <th>Latest Report</th>
                            <th>Reason</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model)
                        {
                            <tr>
                                <td>
                                    <a class="report-story-link"
                                           href="@Url.Action("Details", "Story", new { area = "", id = report.StoryId })">
                                        @report.StoryTitle
                                    </a>
                                </td>
                                <td>@report.AuthorName</td>
                                <td>@report.ReportsCount</td>
                                <td>@report.LatestReportDate.ToString("dd MMM yyyy")</td>
                                <td>@report.LatestReason</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(report.LatestDescription))
                                    {
                                        @report.LatestDescription
                                    }
                                    else
                                    {
                                        <span class="report-empty-text">No description provided</span>
                                    }
                                </td>
                                <td>
                                    <div class="report-actions">
                                        <a class="btn btn-outline"
                                               href="@Url.Action("Details", "Story", new { area = "", id = report.StoryId })">
                                            View Story
                                        </a>

                                        <form action="@Url.Action("Resolve", "Reports", new { area = "Admin" })"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="storyId" value="@report.StoryId" />

                                            <button type="submit" class="btn btn-primary">
                                                Resolve
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>