@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<section class="auth-section">

    <div class="auth-card">

        <h2 class="auth-title">Login</h2>

        <form method="post">

            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <div class="form-group">
                <label asp-for="Input.Email"></label>

                <div class="input-wrapper">
                    <span class="input-icon">📧</span>
                    <input asp-for="Input.Email" class="form-input" autocomplete="username" />
                </div>

                <span asp-validation-for="Input.Email" class="validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password"></label>

                <div class="input-wrapper">
                    <span class="input-icon">🔒</span>
                    <input asp-for="Input.Password" class="form-input password-input" type="password" />
                    <span class="toggle-password">👁</span>
                </div>

                <span asp-validation-for="Input.Password" class="validation"></span>
            </div>

            <div class="form-remember">
                <input asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe"></label>
            </div>

            <button type="submit" class="btn btn-primary auth-button">
                Login
            </button>

            <div class="auth-links">
                <a asp-page="./ForgotPassword">Forgot password?</a>
                <a asp-page="./Register">Create account</a>
            </div>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
