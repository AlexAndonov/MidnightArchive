@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="account-manage-page">
    <div class="container">
        <div class="account-manage-header">
            <h1>Manage Your Account</h1>
            <p>Update your account settings and personal information.</p>
        </div>

        <div class="account-manage-grid">
            <aside class="account-manage-sidebar">
                <partial name="_ManageNav" />
            </aside>

            <main class="account-manage-content">
                @RenderBody()
            </main>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/account-manage.css" />
}

@await RenderSectionAsync("Scripts", required: false)