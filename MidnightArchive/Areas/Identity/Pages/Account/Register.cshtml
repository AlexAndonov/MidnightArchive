@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<section class="auth-section">

    <div class="auth-card">

        <h2 class="auth-title">Create Account</h2>

        <form method="post">

            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <div class="form-group">
                <label asp-for="Input.Email"></label>

                <div class="input-wrapper">
                    <input asp-for="Input.Email" class="form-input" />
                </div>

                <span asp-validation-for="Input.Email" class="validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password"></label>

                <div class="input-wrapper">
                    <input asp-for="Input.Password" class="form-input password-input" type="password" />
                    <span class="toggle-password">👁</span>
                </div>

                <span asp-validation-for="Input.Password" class="validation"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword"></label>

                <div class="input-wrapper">
                    <input asp-for="Input.ConfirmPassword" class="form-input password-input" type="password" />
                    <span class="toggle-password">👁</span>
                </div>

                <span asp-validation-for="Input.ConfirmPassword" class="validation"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-button">
                Register
            </button>

            <div class="auth-links">
                <a asp-page="./Login">Already have an account?</a>
            </div>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
