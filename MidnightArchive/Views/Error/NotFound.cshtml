@{
    ViewData["Title"] = "Page Not Found";
}

<section class="error-page">
    <div class="container">
        <div class="error-card">
            <div class="error-code">404</div>
            <h1 class="error-title">Page Not Found</h1>
            <p class="error-text">
                The page you are looking for does not exist, was removed, or the link is broken.
            </p>

            <div class="error-actions">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
                <a asp-controller="Story" asp-action="Index" class="btn btn-outline">Browse Stories</a>
            </div>
        </div>
    </div>
</section>