@model MidnightArchive.Core.DTOs.StoryDTOs.StoryEditDto

@{
    ViewData["Title"] = "Edit Story";
}

<section class="story-create-page">
    <div class="story-create-card">
        <div class="story-create-header">
            <p class="story-create-eyebrow">Midnight Archive</p>
            <h1>Edit Story</h1>
            <p class="story-create-subtitle">
                Update your story, improve the content, or move it to a better category.
            </p>
        </div>

        <form asp-action="Edit" method="post" class="story-create-form">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title"
                       class="form-input"
                       placeholder="Enter a title that grabs attention" />
                <span asp-validation-for="Title" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId"
                        asp-items="ViewBag.Categories"
                        class="form-input form-select">
                    <option value="">Select Category</option>
                </select>
                <span asp-validation-for="CategoryId" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Content" class="form-label"></label>
                <textarea asp-for="Content"
                          class="form-input form-textarea"
                          placeholder="Write your full story here..."></textarea>
                <span asp-validation-for="Content" class="form-error"></span>
            </div>

            <div class="form-check-custom">
                <input asp-for="IsAnonymous" class="form-check-custom-input" type="checkbox" />
                <label asp-for="IsAnonymous" class="form-check-custom-label">
                    Post anonymously
                </label>
            </div>

            <div class="story-create-actions">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}