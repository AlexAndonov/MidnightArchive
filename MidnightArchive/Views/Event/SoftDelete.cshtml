@model MidnightArchive.Core.DTOs.EventDTOs.EventDetailsDto

@{
    ViewData["Title"] = "Delete Event";
}

<section class="event-create-page">
    <div class="container">
        <div class="form-container">
            <h1 class="form-title">Delete Event</h1>

            <form asp-action="SoftDelete" method="post">

                <input type="hidden" asp-for="Id" />

                <div class="form-group">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" class="form-input" disabled />
                </div>

                <div class="form-group">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-input form-textarea" disabled></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="Location"></label>
                    <input asp-for="Location" class="form-input" disabled />
                </div>

                <div class="form-group">
                    <label asp-for="StartDate"></label>
                    <input asp-for="StartDate" type="date" class="form-input" disabled />
                </div>

                <div class="form-group">
                    <label asp-for="EndDate"></label>
                    <input asp-for="EndDate" type="date" class="form-input" disabled/>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Delete</button>

                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</section>