@model IEnumerable<MidnightArchive.Core.DTOs.EventDTOs.EventListDto>

@{
    ViewData["Title"] = "Events";
}

<section class="events-page">
    <div class="container">
        <div class="events-page-header">
            <div>
                <h1 class="events-page-title">Events</h1>
                <p class="events-page-subtitle">
                    Discover upcoming MidnightArchive events, gatherings, and community experiences.
                </p>
            </div>

            <div class="events-page-actions">
                <a asp-controller="Event" asp-action="Create" class="btn btn-primary">Create Event</a>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state-card">
                <h2>No events yet</h2>
                <p>There are no events available at the moment.</p>
            </div>
        }
        else
        {
            <div class="events-grid">
                @foreach (var eventItem in Model)
                {
                    <article class="event-card">
                        <div class="event-card-body">
                            <div class="event-card-meta">
                                <span class="event-date">
                                    @eventItem.StartDate.ToString("dd MMM yyyy")
                                </span>
                            </div>

                            <h2 class="event-card-title">@eventItem.Title</h2>

                            @if (!string.IsNullOrWhiteSpace(eventItem.Location))
                            {
                                <p class="event-card-location">@eventItem.Location</p>
                            }
                            else
                            {
                                <p class="event-card-location">Online</p>
                            }
                        </div>

                        <div class="event-card-footer">
                            <a asp-controller="Event"
                                   asp-action="Details"
                                   asp-route-id="@eventItem.Id"
                                   class="btn btn-outline">
                                View Details
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>