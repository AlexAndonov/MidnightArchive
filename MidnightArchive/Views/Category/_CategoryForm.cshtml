@model MidnightArchive.Core.DTOs.CategoryDTOs.CategoryFormDto

<form asp-action="@ViewData["Action"]" method="post" class="form">
    @if (Model.Id.HasValue)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" />
        <span asp-validation-for="Title" class="validation"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description"></textarea>
        <span asp-validation-for="Description" class="validation"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            @ViewData["ButtonText"]
        </button>
        <a asp-action="Index" class="btn btn-outline">Cancel</a>
    </div>
</form>
