@model CategoryDetailDto

<h1>@Model.Title</h1>
<p>@Model.Description</p>

@if (!Model.Stories.Items.Any())
{
    <p>No stories in this category yet.</p>
}
else
{
    <div class="stories-grid">
        @foreach (var story in Model.Stories.Items)
        {
            <div class="story-card">
                <h3>@story.Title</h3>
                <p>@story.Preview</p>
                <small>By @story.AuthorName on @story.CreatedOn.ToShortDateString()</small>
                <a asp-controller="Story" asp-action="Details" asp-route-id="@story.Id" class="btn btn-primary">Read More</a>
            </div>
        }
    </div>

    <div class="pagination">
        @if (Model.Stories.Page > 1)
        {
            <a asp-action="Details" asp-route-id="@Model.Id" asp-route-page="@(Model.Stories.Page - 1)" class="btn btn-outline">Prev</a>
        }

        <span>Page @Model.Stories.Page of @Model.Stories.TotalPages</span>

        @if (Model.Stories.Page < Model.Stories.TotalPages)
        {
            <a asp-action="Details" asp-route-id="@Model.Id" asp-route-page="@(Model.Stories.Page + 1)" class="btn btn-outline">Next</a>
        }
    </div>
}
