@model MidnightArchive.Core.DTOs.Home.HomeIndexDto

@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero-text">
        <h1>TRUE SCARY STORIES BASED ON REAL EXPERIENCES</h1>
        <h4 class="hero-subtitle">
            Real-life horror encounters, paranormal experiences and the darkest
            stories shared by people around the world.
        </h4>

        <div class="hero-actions">
            <a asp-controller="Story" asp-action="Create" class="btn btn-primary">Write Your Story</a>
            <a asp-controller="Story" asp-action="Random" class="btn btn-outline">Read a Random Story</a>
        </div>
    </div>
</section>

<section class="top-stories">
    <h2 class="section-title">Top Stories of the Month</h2>
    <div class="story-grid">
        @if (Model.TopStoriesOfMonth != null && Model.TopStoriesOfMonth.Any())
        {
            @foreach (var story in Model.TopStoriesOfMonth)
            {
                <article class="story-card">
                    <h3>@story.Title</h3>
                    <p class="story-excerpt">@story.Preview</p>
                    <div class="story-meta-wrapper">
                        <div class="story-meta">
                            <span>👁 @story.ViewsCount</span>
                            <span>❤ @story.LikesCount</span>
                        </div>
                        <a asp-controller="Story" asp-action="Details" asp-route-id="@story.Id" class="btn btn-outline">
                            Read
                        </a>
                    </div>
                </article>
            }
        }
        else
        {
            <p class="empty-section-text">No top stories available right now.</p>
        }
    </div>
</section>

<section class="random-story-section">
    <div class="random-story-content">
        <h2 class="section-title">Don’t Know What to Read?</h2>
        <p class="random-story-text">
            Let the archive choose for you. Discover a chilling story at random
            and dive straight into the unknown.
        </p>
        <a asp-controller="Story" asp-action="Random" class="btn btn-primary">Read a Random Story</a>
    </div>
</section>

<section class="latest-stories">
    <h2 class="section-title">Latest Stories</h2>
    <div class="story-grid">
        @if (Model.LatestStories != null && Model.LatestStories.Any())
        {
            @foreach (var story in Model.LatestStories)
            {
                <article class="story-card">
                    <h3>@story.Title</h3>
                    <p class="story-excerpt">@story.Preview</p>
                    <div class="story-meta-wrapper">
                        <div class="story-meta">
                            <span>👁 @story.ViewsCount</span>
                            <span>❤ @story.LikesCount</span>
                        </div>
                        <a asp-controller="Story" asp-action="Details" asp-route-id="@story.Id" class="btn btn-outline">
                            Read
                        </a>
                    </div>
                </article>
            }
        }
        else
        {
            <p class="empty-section-text">No latest stories available right now.</p>
        }
    </div>
</section>

<section class="featured-categories">
    <h2 class="section-title">Featured Categories</h2>
    <div class="categories-grid">
        @if (Model.FeaturedCategories != null && Model.FeaturedCategories.Any())
        {
            @foreach (var category in Model.FeaturedCategories)
            {
                <article class="category-card">
                    <h3>@category.Title</h3>
                    <p>@category.Description</p>
                    <span>@category.StoriesCount stories</span>
                    <a asp-controller="Category" asp-action="Details" asp-route-id="@category.Id" class="btn btn-outline">
                        Explore Stories
                    </a>
                </article>
            }
        }
        else
        {
            <p class="empty-section-text">No featured categories available right now.</p>
        }
    </div>
</section>

@if (Model.FeaturedEvents != null && Model.FeaturedEvents.Any())
{
    <section class="featured-events">
        <h2 class="section-title">Featured Events</h2>
        <div class="categories-grid">
            @foreach (var ev in Model.FeaturedEvents)
            {
                <article class="category-card">
                    <h3>@ev.Title</h3>
                    <span>@ev.StartDate.ToString("dd MMM yyyy")</span>
                    <a asp-controller="Event" asp-action="Details" asp-route-id="@ev.Id" class="btn btn-outline">
                        View Event
                    </a>
                </article>
            }
        </div>
    </section>
}

<section class="write-story-section">
    <div class="write-story-content">
        <h2 class="section-title">Have a Story That Still Haunts You?</h2>
        <p class="write-story-text">
            Share your real experience with the MidnightArchive community.
            Your story might become the next unforgettable read.
        </p>
        <a asp-controller="Story" asp-action="Create" class="btn btn-primary">Write Your Story</a>
    </div>
</section>

<footer class="site-footer">
    <div class="footer-grid">
        <div class="footer-brand">
            <h3>MidnightArchive</h3>
            <p>
                A home for real scary stories, paranormal encounters,
                and unsettling experiences shared by people around the world.
            </p>
        </div>

        <div class="footer-links">
            <h4>Explore</h4>
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Story" asp-action="Random">Random Story</a></li>
                <li><a asp-controller="Category" asp-action="Index">Categories</a></li>
                <li><a asp-controller="Event" asp-action="Index">Events</a></li>
            </ul>
        </div>

        <div class="footer-links">
            <h4>Contribute</h4>
            <ul>
                <li><a asp-controller="Story" asp-action="Create">Write Your Story</a></li>
                <li><a asp-controller="Event" asp-action="Create">Create Event</a></li>
            </ul>
        </div>

        <div class="footer-links">
            <h4>Account</h4>
            <ul>
                <li><a asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                <li><a asp-area="Identity" asp-page="/Account/Register">Register</a></li>
            </ul>
        </div>
    </div>

    <div class="footer-bottom">
        <p>&copy; @DateTime.UtcNow.Year MidnightArchive. All rights reserved.</p>
    </div>
</footer>