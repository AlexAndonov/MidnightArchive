{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ApplicationDbContextConnection": "Server=(localdb)\\mssqllocaldb;Database=MidnightArchive;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "IdentityOptions": {
    "Password": {
      "RequireDigit": true,
      "RequiredLength": 8,
      "RequiredUniqueChars": 3,
      "RequireNonAlphanumeric": true,
      "RequireUppercase": true,
      "RequireLowercase": true
    },
    "SignIn": {
      "RequireConfirmedAccount": true,
      "RequireConfirmedPhoneNumber": false,
      "RequireConfirmedEmail": true
    }
  },
  "Redis": {
    "ConnectionString" : "localhost:6379"
  }
}